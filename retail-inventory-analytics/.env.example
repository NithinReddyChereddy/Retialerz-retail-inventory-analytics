# Copy to .env (optional) or set real environment variables.
# Local MongoDB (no credentials):
MONGODB_URI=mongodb://localhost:27017
# Atlas example (put YOUR credentials in .env, never in source control):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=retail_inventory
# Tests use a SEPARATE database so demo data is never touched:
MONGODB_TEST_DB_NAME=retail_inventory_test
CURRENCY_SYMBOL=$
